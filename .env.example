# Canonical production origin used for metadata, robots.txt, and sitemap.xml.
# Example: https://www.example.com
SITE_URL=

# Optional ownership tokens for search-engine webmaster tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional, commit-pinned root of the repository's public/ directory.
# Example:
# https://raw.githubusercontent.com/ORG/REPO/COMMIT_SHA/public
NEXT_PUBLIC_TEMPLATE_ASSET_BASE_URL=
TEMPLATE_ASSET_BASE_URL=
