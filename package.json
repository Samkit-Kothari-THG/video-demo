{
  "name": "video-invite-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "remotion:studio": "remotion studio src/index.ts --host 0.0.0.0",
    "editor": "next dev --webpack",
    "typecheck": "tsc --noEmit",
    "render:engagement": "remotion render src/index.ts EngagementInvite out/EngagementInvite.mp4",
    "render:wedding": "remotion render src/index.ts WeddingNoor out/WeddingNoor.mp4",
    "render:birthday": "remotion render src/index.ts BirthdayConfetti out/BirthdayConfetti.mp4",
    "render:baby-shower": "remotion render src/index.ts BabyShowerMoon out/BabyShowerMoon.mp4",
    "render:housewarming": "remotion render src/index.ts HousewarmingAangan out/HousewarmingAangan.mp4",
    "render:hello": "remotion render src/index.ts HelloWorld out/HelloWorld.mp4",
    "render:launch": "remotion render src/index.ts LaunchDay out/LaunchDay.mp4",
    "render:intro": "remotion render src/index.ts IntroSequence out/IntroSequence.mp4",
    "render:fts": "remotion render src/index.ts FirstTimeSpeakers out/FirstTimeSpeakers.mp4",
    "render:webslinger": "remotion render src/index.ts WebSlingerIntro out/WebSlingerIntro.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "@remotion/bundler": "4.0.499",
    "@remotion/player": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.499"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "26.1.1",
    "typescript": "5.7.3"
  }
}
